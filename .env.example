# ════════════════════════════════════════════════════════════════
# Vida Leve — variáveis de ambiente
# Copie para .env.local (desenvolvimento) e cadastre na Vercel (produção).
# Variáveis NEXT_PUBLIC_* ficam visíveis no navegador: nunca coloque segredos nelas.
# ════════════════════════════════════════════════════════════════

# ── Site ──
NEXT_PUBLIC_SITE_URL=https://seu-dominio.com.br

# ── Supabase (Project Settings → API) ──
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SECRETA — usada apenas no servidor (webhooks). Nunca exponha.
SUPABASE_SERVICE_ROLE_KEY=

# Modo demonstração (sem Supabase, dados no navegador). Em produção, deixe vazio.
NEXT_PUBLIC_DEMO_MODE=

# ── Oferta (o painel /admin/configuracoes tem prioridade sobre estes valores) ──
NEXT_PUBLIC_PRICE_CENTS=2990
NEXT_PUBLIC_CHECKOUT_URL=
NEXT_PUBLIC_SUPPORT_EMAIL=
NEXT_PUBLIC_SUPPORT_WHATSAPP=
NEXT_PUBLIC_COMPANY_NAME=
NEXT_PUBLIC_COMPANY_DOCUMENT=

# ── Webhooks de pagamento (SECRETOS) ──
# Cakto: o mesmo valor do campo "secret" do webhook criado no painel da Cakto
CAKTO_WEBHOOK_SECRET=
# Formato genérico documentado no README (HMAC-SHA256). Gere com: openssl rand -hex 32
GENERIC_WEBHOOK_SECRET=

# ── Rastreamento ──
NEXT_PUBLIC_META_PIXEL_ID=
# Conversions API (Purchase enviado pelo servidor após pagamento confirmado) — SECRETO
META_CAPI_ACCESS_TOKEN=
META_GRAPH_API_VERSION=v23.0
# "true" envia o e-mail com hash SHA-256 para melhorar a correspondência (avalie com seu jurídico)
META_CAPI_SEND_EMAIL_HASH=false
# Código de teste do Gerenciador de Eventos (apenas durante testes)
META_TEST_EVENT_CODE=

NEXT_PUBLIC_GA4_ID=
# GA4 → Administrador → Fluxos de dados → Measurement Protocol API secrets — SECRETO
GA4_API_SECRET=

# UTMify: copie o ID do pixel e a URL do script exatamente como aparecem no painel da UTMify
NEXT_PUBLIC_UTMIFY_PIXEL_ID=
NEXT_PUBLIC_UTMIFY_SCRIPT_URL=
